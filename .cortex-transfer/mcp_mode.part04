+    response = LocalToolResponse(MessageId(message), {
+        {"ok", true}, {"status", "detached"}, {"target", TargetDescriptorJson(runtime->target, false)}, {"count", count}
+    });
+    EmitToolsListChanged(state);
+    return true;
+}
